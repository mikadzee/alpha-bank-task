{
  "info": {
    "_postman_id": "8d99b33f-87e0-4f11-9d7a-64b1bdcc90f0",
    "name": "Alfa Bank Demo API",
    "description": "Основные маршруты демонстрационного MVP. Переменная token — access token из ответа login/register. Refresh cookie работает в браузере; для Postman включите cookie jar для localhost.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000/api/v1"},
    {"key": "token", "value": ""},
    {"key": "applicationId", "value": ""},
    {"key": "productId", "value": ""}
  ],
  "item": [
    {"name": "Auth", "item": [
      {"name": "Login client demo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"demo@creditory.local\",\n  \"password\": \"ClientDemo2026!\"\n}"}, "url": "{{baseUrl}}/auth/login"}},
      {"name": "Register client", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"founder@example.test\",\n  \"password\": \"DemoPassword2026!\",\n  \"passwordConfirmation\": \"DemoPassword2026!\"\n}"}, "url": "{{baseUrl}}/auth/register"}},
      {"name": "Current user", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/auth/me"}},
      {"name": "Refresh (cookie jar)", "request": {"method": "POST", "url": "{{baseUrl}}/auth/refresh"}},
      {"name": "Logout", "request": {"method": "POST", "url": "{{baseUrl}}/auth/logout"}}
    ]},
    {"name": "Client journey", "item": [
      {"name": "List companies", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/companies"}},
      {"name": "Lookup demo company", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/companies/lookup?inn=7701234567"}},
      {"name": "Create draft", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "POST", "url": "{{baseUrl}}/applications"}},
      {"name": "Update draft data", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"companyData\": {\"inn\": \"7701234567\", \"ogrn\": \"1237700123456\", \"companyName\": \"ООО ТехноПлюс\", \"address\": \"г. Москва\", \"okved\": \"28.99\"},\n  \"financialData\": {\"annualRevenue\": 12000000, \"monthlyExpenses\": 500000, \"requestedAmount\": 1000000, \"requestedTermMonths\": 24, \"purpose\": \"working_capital\", \"purposeDetails\": \"Закупка сырья\"}\n}"}, "url": "{{baseUrl}}/applications/{{applicationId}}"}},
      {"name": "Catalog", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/products"}},
      {"name": "Business feed", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/feed"}},
      {"name": "Recommendations", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/applications/{{applicationId}}/recommendations"}},
      {"name": "Submit (after uploading required docs)", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\"\n}"}, "url": "{{baseUrl}}/applications/{{applicationId}}/submit"}}
    ]},
    {"name": "Bank employee", "item": [
      {"name": "Login reviewer demo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"reviewer@creditory.local\",\n  \"password\": \"ReviewerDemo2026!\"\n}"}, "url": "{{baseUrl}}/auth/login"}},
      {"name": "Queue", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/staff/applications?status=pending"}},
      {"name": "Review detail", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/staff/applications/{{applicationId}}"}},
      {"name": "Request clarification", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"decision\": \"needs_info\",\n  \"comment\": \"Уточните назначение расходов и приложите актуальную отчётность.\"\n}"}, "url": "{{baseUrl}}/staff/applications/{{applicationId}}/decision"}}
      ,{"name": "Counteroffer", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"decision\": \"counteroffer\",\n  \"comment\": \"Чтобы снизить платёжную нагрузку, предлагаем уменьшить сумму.\",\n  \"proposedAmount\": 800000,\n  \"proposedTermMonths\": 36\n}"}, "url": "{{baseUrl}}/staff/applications/{{applicationId}}/decision"}}
      ,{"name": "Accept bank counteroffer", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"decision\": \"accept\"\n}"}, "url": "{{baseUrl}}/applications/{{applicationId}}/offer-decision"}}
    ]}
  ]
}
